# Public (bundled into the static site). Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Include local networks (Anvil) in the network list. Must be false for production builds.
NEXT_PUBLIC_ENABLE_LOCAL_NETWORKS=true
# Shared-wallet UI (Shared nav, /shared, Gas Service in Settings). Test networks only.
# Read at dev-server start / build time. The API needs ENABLE_SHARED_WALLETS=true too.
NEXT_PUBLIC_ENABLE_SHARED_WALLETS=false
