# Copy to .env for docker compose. NEVER commit real values.
# Upstream RPC providers (server-side only; never exposed to clients).
# Format: EVM_RPC_<chainId>=name=url[,name=url...]
# Ethereum Sepolia via Alchemy. Read by wallet-api only; the browser talks to the proxy.
EVM_RPC_11155111=alchemy=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
EVM_RPC_1=
EVM_RPC_8453=
EVM_RPC_42161=
EVM_RPC_137=
PRICE_PROVIDER=static
COINGECKO_API_KEY=

# Shared-wallet relayer for Sepolia (development only; refused when APP_ENV=production).
# A throwaway key that only pays gas to submit Raccoon-signed calls; it cannot move
# shared funds. Generate with `cast wallet new` and fund it from a Sepolia faucet.
RELAYER_PRIVATE_KEY_11155111=
# Optional: Gas Service Account low-balance warning threshold in wei (default: the cost of
# setting up one new shared-wallet key and executing once at current gas prices).
# GAS_LOW_BALANCE_WEI_11155111=10000000000000000
