# Copy to .env for docker compose. NEVER commit real values.
# Upstream RPC providers (server-side only; never exposed to clients).
# Format: EVM_RPC_<chainId>=name=url[,name=url...]
# Ethereum Sepolia via Alchemy. Read by wallet-api only; the browser talks to the proxy.
EVM_RPC_11155111=alchemy=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
EVM_RPC_1=
EVM_RPC_8453=
EVM_RPC_42161=
EVM_RPC_137=
PRICE_PROVIDER=static
COINGECKO_API_KEY=
