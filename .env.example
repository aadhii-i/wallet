# Copy to .env for docker compose. NEVER commit real values.
# Upstream RPC providers (server-side only; never exposed to clients).
# Format: EVM_RPC_<chainId>=name=url[,name=url...]
# Ethereum Sepolia via Alchemy. Read by wallet-api only; the browser talks to the proxy.
# The second provider is a fallback: used only while Alchemy fails or is
# cooling down after an HTTP 429 (every provider's chain id is verified first).
EVM_RPC_11155111=alchemy=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY,publicnode=https://ethereum-sepolia-rpc.publicnode.com
# Background RPC work (chain indexing) per provider, calls per
# second, on public chains. Keeps it from using the quota the wallet and the
# relayer need. Default 3; 0 = unlimited.
# RPC_BACKGROUND_RPS=3
EVM_RPC_1=
EVM_RPC_8453=
EVM_RPC_42161=
EVM_RPC_137=
PRICE_PROVIDER=static
COINGECKO_API_KEY=
# Bitcoin Esplora REST API (server-side only; never exposed to clients).
# Bitcoin support is OFF while BTC_ESPLORA_URL is empty.
# Use the Mempool.space public API — no node required.
#   Testnet4: https://mempool.space/testnet4/api
#   Mainnet:  https://mempool.space/api
BTC_ESPLORA_URL=
# Network the Esplora instance indexes: mainnet or testnet4.
BTC_NETWORK=
# Fee policy bounds in sat/vB. Every quoted rate is clamped into this band.
BTC_FEE_FLOOR_SAT_VB=1
BTC_MAX_FEE_SAT_VB=500

# Shared wallets, Gas Service, proposals, threshold signing and Wallet History.
# Off unless set: set BOTH to true for local development (the API flag registers
# the routes and starts the relayer; the web flag shows the UI and is read when
# `make web` / `pnpm build` starts). An empty value means off.
ENABLE_SHARED_WALLETS=false
NEXT_PUBLIC_ENABLE_SHARED_WALLETS=false

# Shared-wallet relayer for Sepolia (development only; refused when APP_ENV=production).
# A throwaway key that only pays gas to submit Raccoon-signed calls; it cannot move
# shared funds. Generate with `cast wallet new` and fund it from a Sepolia faucet.
RELAYER_PRIVATE_KEY_11155111=
# Optional: Gas Service Account low-balance warning threshold in wei (default: the cost of
# setting up one new shared-wallet key and executing once at current gas prices).
# GAS_LOW_BALANCE_WEI_11155111=10000000000000000

# --- Keys (production) --------------------------------------------------------
# KEY_MANAGER: "env" (the default when APP_ENV=production) loads keys from the
# variables below and never generates any. "localdev" (the default elsewhere)
# generates keys into DEV_KEY_DIR and is refused in production.
# KEY_MANAGER=env
# JWT_SIGNING_KEY: P-256 private key that signs access tokens. Generate once and
# store it as a secret (base64 of the PEM fits in one line):
#   openssl ecparam -name prime256v1 -genkey -noout | base64 -w0
# JWT_SIGNING_KEY=
# KEY_ENCRYPTION_KEY (optional): 32 random bytes, base64. For the key manager's
# Encrypt/Decrypt (unused by current features):
#   openssl rand -base64 32
# KEY_ENCRYPTION_KEY=
# Required in production too: CSRF_KEY and IP_HASH_KEY (each at least 32 random
# characters, e.g. openssl rand -base64 32). Keep all four stable across deploys.
